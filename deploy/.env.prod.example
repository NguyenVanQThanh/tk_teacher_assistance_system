# =====================================================================
# Template biến môi trường PRODUCTION — copy thành deploy/.env.prod rồi
# điền giá trị thật. KHÔNG commit file .env.prod (đã có trong .gitignore).
# =====================================================================

# --- Image registry (image-only deploy: server chỉ pull, KHÔNG build) ---
# Dùng bởi deploy/docker-compose.images.yml. Tên image GHCR phải VIẾT THƯỜNG.
# Lấy owner từ: git remote get-url origin  -> github.com/<owner>/<repo>
BACKEND_IMAGE=ghcr.io/<github-owner>/smartlms-backend
FRONTEND_IMAGE=ghcr.io/<github-owner>/smartlms-frontend
# Tag do CI/deploy-remote.ps1 ghi đè; đổi tay về tag cũ để rollback.
IMAGE_TAG=latest

# --- Cổng publish của nginx container (chỉ khi bật --profile proxy/tunnel) ---
# Server trống, chưa có gì chiếm port 80:
#   NGINX_BIND=0.0.0.0
#   NGINX_PORT=80
# Đã có nginx host trên :80, hoặc dùng Cloudflare Tunnel -> chỉ bind localhost:
#   NGINX_BIND=127.0.0.1
#   NGINX_PORT=8080
NGINX_BIND=0.0.0.0
NGINX_PORT=80

# --- Cloudflare Tunnel (chỉ cần khi deploy với --profile tunnel) ---
# Lấy token: Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared.
# Public hostname trên dashboard trỏ vào: http://nginx:80
# Để trống nếu không dùng tunnel (service cloudflared không được start).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<doi-mat-khau-manh>
POSTGRES_DB=teacher_assistance

# --- Backend DB (GIỮ TRÙNG với POSTGRES_* ở trên) ---
# compose prod override DB_HOST=postgres, các giá trị dưới đọc từ file này
DB_USER=postgres
DB_PASSWORD=<doi-mat-khau-manh>
DB_NAME=teacher_assistance
DB_PORT=5432

# --- Connection pool / timeout (30 user đồng thời) ---
# Code default 20 + 30 = 50; prod dùng cùng giá trị để có headroom cho
# session ngắn hạn của middleware X-Data-Version. Giữ dưới max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000

# --- Giới hạn tác vụ nặng (mỗi process; nhân với số uvicorn worker) ---
PDF_EXPORT_CONCURRENCY=2
IMPORT_CONCURRENCY=2
ETL_CONCURRENCY=1
MAX_INGEST_BYTES=52428800

# --- JWT ---
SECRET_KEY=<chuoi-bi-mat-it-nhat-32-ky-tu>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Account Admin chính (bootstrap tự động khi container backend khởi động) ---
# Alembic chỉ tạo bảng, KHÔNG seed role/permission/user. Trên DB production mới
# tinh sẽ không có ai đăng nhập được, nên backend/docker/entrypoint.sh chạy
# app/scripts/bootstrap_admin.py ngay sau `alembic upgrade head`.
#
# Script này idempotent: chạy lại mỗi lần restart chỉ kiểm tra, KHÔNG đổi mật khẩu
# (trừ khi bật ADMIN_RESET_PASSWORD=1). Đăng nhập bằng SỐ ĐIỆN THOẠI, không phải email.
#
# Đổi ADMIN_PHONE + ADMIN_PASSWORD trước khi deploy. Để trống cả hai => bỏ qua
# bước tạo account (dùng cho dev/CI).
ADMIN_PHONE=0999000001
ADMIN_PASSWORD=<doi-mat-khau-manh-it-nhat-8-ky-tu>
ADMIN_EMAIL=admin@school.com
ADMIN_FULL_NAME=System Administrator
# Đặt 1 khi bạn quên mật khẩu admin và muốn ép về ADMIN_PASSWORD ở trên.
# Nhớ đưa về 0 sau khi đã đăng nhập được, nếu không mỗi lần deploy lại reset tiếp.
ADMIN_RESET_PASSWORD=0

# --- Frontend: URL API mà browser gọi ---
# Khi bật nginx proxy (profile "proxy"): để /api  (nginx tự strip prefix)
# Nếu không dùng proxy và mở thẳng port 8000: để http://<server-ip>:8000
VITE_API_BASE_URL=/api

# --- AI API key (hệ thống hiện dùng API thay vì model local/torch) ---
SCAN_AI_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=mistral-large-4-0
MISTRAL_OCR_MODEL=mistral-ocr-2512
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
ANSWER_SOLVER_ENABLED=true
ANSWER_SOLVER_MODEL=mistral-large-4-0
SCAN_OCR_FIRST=false

# --- Lưu ảnh câu hỏi trên BE (local) — dùng khi STORAGE_BACKEND=local để rollback ---
QUESTION_IMAGE_DIR=uploads/questions
QUESTION_IMAGE_URL_PREFIX=/uploads/questions
QUESTION_IMAGE_MAX_BYTES=10485760

# =====================================================================
# --- Lưu trữ file upload trên Cloudflare R2 (S3-compatible, egress $0) ---
# Kế hoạch chi tiết: deploy/PLAN-R2-STORAGE.md
# =====================================================================
# "local" = lưu trên đĩa container (volume backend_uploads); "r2" = Cloudflare R2.
# "cloud" và "s3" là alias của "r2". Đổi flag này là đủ để rollback, không cần sửa code.
# Để "local" cho lần deploy đầu (không cần credential); điền đủ R2_* rồi mới đổi sang "r2".
STORAGE_BACKEND=local
# Endpoint R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (boto3 region "auto")
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-api-token-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-api-token-secret-access-key>
R2_BUCKET=smartlms-uploads
# Domain public của bucket (custom domain trên Cloudflare hoặc *.r2.dev)
# dùng để trả URL tải file về cho người dùng
R2_PUBLIC_BASE_URL=https://files.<your-domain>
