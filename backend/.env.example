DB_USERNAME=postgres
DB_PASSWORD=dummy_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teacher_assistance
SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Vision OCR provider for scanned exams (scan bài kiểm tra)
# Primary provider: 'mistral' (default) or 'gemini'. The other one is used as automatic fallback.
SCAN_AI_PROVIDER=mistral
# Max PDF pages sent per vision API request (default 2; raise if the model has a larger output cap)
# SCAN_MAX_PAGES_PER_CALL=2

# Mistral AI Vision OCR API Configuration (Pixtral)
MISTRAL_API_KEY=
SCAN_AI_PROVIDER=mistral
MISTRAL_MODEL_NAME=mistral-large-4-0
ANSWER_SOLVER_ENABLED=true
ANSWER_SOLVER_MODEL=mistral-large-4-0
SCAN_OCR_FIRST=false
MISTRAL_OCR_MODEL=mistral-ocr-2512
# MISTRAL_MAX_TOKENS=8192  # Pixtral output cap; raise only if your model allows more
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Google Gemini Vision OCR API Configuration (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Question image storage (BE storage) - override to change path/URL prefix
QUESTION_IMAGE_DIR=uploads/questions
QUESTION_IMAGE_URL_PREFIX=/uploads/questions
QUESTION_IMAGE_MAX_BYTES=10485760

# File storage backend for uploaded files: local (default) or r2 (Cloudflare R2, S3-compatible).
# The DB keeps storing URL strings, so switching backends does not change the schema.
STORAGE_BACKEND=local
# Root directory used by local storage (default: uploads). If changed, keep
# QUESTION_IMAGE_DIR/SGK_IMAGE_DIR in sync so the static mounts serve the same files.
# UPLOAD_ROOT=uploads

# Cloudflare R2 (only needed when STORAGE_BACKEND=r2/cloud/s3).
# Create an R2 API token with Object Read & Write access, then set:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (custom domain or r2.dev URL), e.g. https://files.example.com
R2_PUBLIC_BASE_URL=
